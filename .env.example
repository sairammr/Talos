# Talos keeper config. Copy to keeper/.env and edit for a real testnet.
# LOCAL ANVIL (default): no config needed — run.sh works out of the box.

# --- Chain ---
# Base Sepolia example:
# RPC_URL=https://sepolia.base.org
# CHAIN_ID=84532
# USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e   # Base Sepolia USDC (verify before use)
# ESCROW_ADDRESS=0x...                                       # written by run.sh after deploy

# --- Keys (NEVER commit real keys; these defaults are public anvil test keys) ---
# Distinct accounts for buyer / seller / settler. On testnet, fund each with test ETH.
# BUYER_KEY=0x...
# SELLER_KEY=0x...
# SETTLER_KEY=0x...          # the KeeperHub-controlled signer == contract `settler`
# DEPLOYER_KEY=0x...
# SETTLER_ADDR=0x...         # address of SETTLER_KEY; passed to the contract constructor

# --- x402 delivery endpoint ---
# SELLER_PORT=4021
# SELLER_URL=http://127.0.0.1:4021

# --- KeeperHub actuation (optional) ---
# If set, settlement legs POST to the KeeperHub workflow webhook (Web3 Action signs the tx).
# If unset, the settler wallet submits directly (labeled "settler-fallback" in the audit trail).
# KEEPERHUB_WEBHOOK_URL=https://app.keeperhub.com/api/workflows/<id>/trigger
# KEEPERHUB_API_KEY=${KEEPERHUB_API_KEY}   # reference an env var; do not paste the secret

# --- Watcher ---
# POLL_MS=1500
